RROTOR_RUNTIME_ID=${runtime_id}
RROTOR_RUNTIME_TOKEN=${runtime_token}
RROTOR_PUBLIC_HOST=${public_host}
RROTOR_VERSION=${version}
RROTOR_SERVER=${server}
RROTOR_CPUS=${cpus}
RROTOR_MEMORY=${memory}
%{ if licence != "" ~}
GLYPHH_LICENSE_KEY=${licence}
%{ endif ~}
%{ if keys != "" ~}
RROTOR_KEYS_SHA256=${keys}
%{ endif ~}
RROTOR_SERVER_LOGS=${server_logs}
RROTOR_LOG_PAYLOADS=${log_payloads}
RROTOR_AUDIT_RETENTION_DAYS=${audit_days}
%{ if otel_endpoint != "" ~}
OTEL_EXPORTER_OTLP_ENDPOINT=${otel_endpoint}
%{ endif ~}
%{ if otel_headers != "" ~}
OTEL_EXPORTER_OTLP_HEADERS=${otel_headers}
%{ endif ~}
%{ if otel_resource != "" ~}
OTEL_RESOURCE_ATTRIBUTES=${otel_resource}
%{ endif ~}
%{ if node_id != "" ~}
RROTOR_NODE_ID=${node_id}
RROTOR_CLUSTER_ADVERTISE=${advertise}
RROTOR_CLUSTER_PEERS=${peers}
RROTOR_CLUSTER_HEAD=${head}
RROTOR_DRAIN_AT=${drain_at}
%{ endif ~}
