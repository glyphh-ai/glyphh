#cloud-config
# rrotor on one VM (deploy/terraform): Docker, the sandbox's kernel setting, the data disk at /mnt/rrotor, and the
# Docker Compose package from deploy/compose with its .env, started once. Runs on the first boot of each instance.
package_update: true
packages:
  - docker.io
  - docker-compose-v2

write_files:
  # Ubuntu 23.10 and later stop unprivileged user namespaces through AppArmor; bwrap needs them for each run.
  - path: /etc/sysctl.d/60-rrotor-userns.conf
    permissions: "0644"
    content: |
      kernel.apparmor_restrict_unprivileged_userns = 0
  - path: /opt/rrotor/docker-compose.yml
    permissions: "0644"
    encoding: b64
    content: ${compose}
%{ if node_compose == "" ~}
  - path: /opt/rrotor/Caddyfile
    permissions: "0644"
    encoding: b64
    content: ${caddyfile}
  # rrotor's data and Caddy's certificates on the data disk, so they outlive the instance.
  - path: /opt/rrotor/docker-compose.override.yml
    permissions: "0644"
    content: |
      services:
        caddy:
          volumes:
            - /mnt/rrotor/caddy:/data
      volumes:
%{ else ~}
  - path: /opt/rrotor/docker-compose.node.yml
    permissions: "0644"
    encoding: b64
    content: ${node_compose}
  # rrotor's data on the data disk, so it outlives the instance.
  - path: /opt/rrotor/docker-compose.override.yml
    permissions: "0644"
    content: |
      volumes:
%{ endif ~}
        rrotor-data:
          driver: local
          driver_opts:
            type: none
            o: bind
            device: /mnt/rrotor/data
  - path: /opt/rrotor/.env
    permissions: "0600"
    encoding: b64
    content: ${env}
  - path: /opt/rrotor/mount-data.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      # Wait for the data disk, format it the first time only, and mount it at /mnt/rrotor.
      set -eu
      dev=${data_device}
      for i in $(seq 1 120); do [ -e "$dev" ] && break; sleep 5; done
      [ -e "$dev" ] || { echo "rrotor: the data disk $dev never appeared" >&2; exit 1; }
      blkid "$dev" >/dev/null 2>&1 || mkfs.ext4 -q -L rrotor-data "$dev"
      mkdir -p /mnt/rrotor
      uuid=$(blkid -s UUID -o value "$dev")
      grep -q "$uuid" /etc/fstab || echo "UUID=$uuid /mnt/rrotor ext4 defaults,nofail 0 2" >> /etc/fstab
      mountpoint -q /mnt/rrotor || mount /mnt/rrotor
      mkdir -p /mnt/rrotor/data /mnt/rrotor/caddy
      chown 10001:10001 /mnt/rrotor/data
%{ if node_compose != "" ~}
  - path: /opt/rrotor/cluster-secret.sh
    permissions: "0700"
    content: |
      #!/bin/sh
      # The cluster secret, from the cloud's secret store with this instance's own identity, into .env (root only).
      set -eu
      for i in $(seq 1 60); do
        s=$(${secret_fetch}) && [ -n "$s" ] && break
        s=; sleep 5
      done
      [ -n "$s" ] || { echo "rrotor: the cluster secret could not be read" >&2; exit 1; }
      sed -i '/^RROTOR_CLUSTER_SECRET=/d' /opt/rrotor/.env
      printf 'RROTOR_CLUSTER_SECRET=%s\n' "$s" >> /opt/rrotor/.env
%{ endif ~}

runcmd:
  - sysctl --system
  - /opt/rrotor/mount-data.sh
  - systemctl enable --now docker
%{ if node_compose == "" ~}
  - cd /opt/rrotor && docker compose up -d
%{ else ~}
  - /opt/rrotor/cluster-secret.sh
  - cd /opt/rrotor && docker compose -f docker-compose.node.yml -f docker-compose.override.yml up -d
%{ endif ~}
