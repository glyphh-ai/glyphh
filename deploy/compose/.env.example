# rrotor's settings for docker-compose.yml. Copy to .env and fill in. The platform (https://platform.glyphh.ai,
# Getting started, Docker Compose) shows this file filled in when you register the runtime; the token is shown once.

# The runtime, from registering it on the platform. Keep the token secret: it is this rrotor's identity to Glyphh.
RROTOR_RUNTIME_ID=
RROTOR_RUNTIME_TOKEN=

# The exact public host rrotor answers at. Point its DNS A (and AAAA) record at this machine before starting, so
# Caddy can obtain the certificate.
RROTOR_PUBLIC_HOST=rrotor.example.com

# The image version (a release, e.g. 0.1.0). latest follows each release; pin one in production.
RROTOR_VERSION=latest

# The size: small 1 CPU and 1g, medium 2 and 4g, large 2 and 8g.
RROTOR_CPUS=1
RROTOR_MEMORY=1g

# The Glyphh server. Leave as it is unless Glyphh tells you otherwise.
# RROTOR_SERVER=https://api.glyphh.ai

# Where rrotor's logs, metrics, traces and audit events go. By default nowhere but this machine: its log lines in
# Docker's log (docker compose logs rrotor) and, on Enterprise, its audit log on its volume (/data/audit).
# A drain to your own OpenTelemetry collector, OTLP over HTTP with protobuf (port 4318; gRPC is not offered, a
# collector forwards it). No endpoint, no drain. The other OTEL_* variables are OpenTelemetry's own.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
# OTEL_SERVICE_NAME=rrotor
# What the drain sends, and how many records per signal it holds while the collector is down (the oldest dropped).
# RROTOR_DRAIN_SIGNALS=logs,metrics,traces,audit
# RROTOR_DRAIN_BUFFER=10000
# In a cluster: head (the followers' signals go by the head, one egress) or node (each exports itself).
# RROTOR_DRAIN_AT=head
# on: programs' and CLI commands' inputs and results in your drain too (4 KB each), never anywhere else.
# RROTOR_LOG_PAYLOADS=off
# on: the same logs, metrics, traces and audit events also go to Glyphh, so the platform can show them. They then
# leave your infrastructure (never inputs, results or callers' addresses). Not with the link off.
# RROTOR_SERVER_LOGS=off
# Enterprise: days of audit log kept, and the most it may take on disk (the oldest day deleted first).
# RROTOR_AUDIT_RETENTION_DAYS=90
# RROTOR_AUDIT_MAX_MB=1024

# Air-gapped only (docker-compose.airgap.yml): the licence key from the platform, and the SHA-256 of each runtime key
# that may call it, comma-separated (printf %s "$KEY" | sha256sum). With the link on, both arrive over the link and
# the heartbeat instead. (RROTOR_LICENCE, an earlier release's name for the licence, is still read.)
# GLYPHH_LICENSE_KEY=
# RROTOR_KEYS_SHA256=

# A cluster (docker-compose.cluster.yml on one machine, or docker-compose.node.yml on each of several; a licence key
# with cluster sync). The secret: 32 or more random bytes in base64 (openssl rand -base64 32), the same on every node;
# anyone with it can join, so keep it as the token is kept. While a new one rolls out, the old in _PREVIOUS.
# RROTOR_CLUSTER_SECRET=
# RROTOR_CLUSTER_SECRET_PREVIOUS=
# docker-compose.node.yml only: this machine's node id and private address, and every node's, the same list on each.
# RROTOR_NODE_ID=rrotor-0
# RROTOR_CLUSTER_ADVERTISE=10.0.1.10:7778
# RROTOR_CLUSTER_PEERS=10.0.1.10:7778,10.0.2.10:7778,10.0.3.10:7778
# RROTOR_CLUSTER_HEAD=rrotor-0
