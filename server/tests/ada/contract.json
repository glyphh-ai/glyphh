{
  "contract": 3,
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Result",
    "description": "What a run of a model's function answers, from POST /v1/runs, /v1/runs/{id}/continue and /v1/runs/{id}/cancel",
    "type": "object",
    "required": ["run_id", "model", "version", "function", "status", "data", "step", "prompt", "seconds"],
    "properties": {
      "run_id": { "type": "string" },
      "model": { "type": "string" },
      "version": { "type": "integer", "minimum": 1 },
      "function": { "type": "string" },
      "status": { "enum": ["done", "needs_input", "needs_approval", "failed", "expired", "cancelled"] },
      "data": {},
      "step": { "type": ["string", "null"] },
      "prompt": { "type": ["string", "null"] },
      "seconds": { "type": "number", "minimum": 0 }
    }
  },
  "answer": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Answer",
    "description": "What an Ada model's query answers: data of a done Result",
    "type": "object",
    "required": ["sufficient", "confidence", "support", "count", "top", "outcomes", "receipts"],
    "properties": {
      "sufficient": { "type": "boolean" },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "support": { "type": "number", "minimum": 0, "maximum": 1 },
      "count": { "type": "integer", "minimum": 0 },
      "top": { "type": ["string", "null"] },
      "outcomes": { "type": "object", "additionalProperties": { "type": "number" } },
      "receipts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "sim", "outcome", "hash", "author"],
          "properties": {
            "id": { "type": "string" },
            "sim": { "type": "number" },
            "outcome": { "type": ["string", "null"] },
            "hash": { "type": "string" },
            "author": { "type": ["string", "null"] }
          }
        }
      }
    }
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Error",
    "type": "object",
    "required": ["error"],
    "properties": {
      "error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
      }
    }
  },
  "limit_exceeded": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LimitExceeded",
    "description": "data of a done Result that indexed nothing: a self-hosted runtime's store is at its licence key's precedent cap",
    "type": "object",
    "required": ["status", "indexed", "message"],
    "properties": {
      "status": { "const": "limit_exceeded" },
      "indexed": { "const": false },
      "message": { "type": "string" },
      "precedents": { "type": "integer", "minimum": 0 },
      "cap": { "type": "integer", "minimum": 0 }
    }
  },
  "cluster": {
    "description": "A clustered self-hosted runtime (rrotor's docs/specs/cluster.md). Every member's answer carries Rrotor-Cluster-Seq; a request may send Rrotor-Min-Seq: <seq> to be answered from a node at least that far. While there is no head: 503 E_NO_HEAD with Retry-After for writes, refused before forwarding, so safe to resend; reads go on. E_HEAD_LOST (503, no Retry-After): the head went while it had the write, which may have been applied: not resent. E_NOT_COMMITTED (503): a write kept but not yet held by most voters. E_RUN_LOST (410): the run's node left. E_READ_ONLY: a failed Result, a function marked \"writes\": false that wrote on a follower.",
    "answer_headers": ["Rrotor-Cluster-Seq", "Retry-After"],
    "request_headers": ["Rrotor-Min-Seq"],
    "codes": ["E_NO_HEAD", "E_HEAD_LOST", "E_NOT_COMMITTED", "E_RUN_LOST", "E_READ_ONLY"]
  }
}
