# The Glyphh server: the API and the authorization server
GLYPHH_SERVER_URL=http://localhost:8080
# Ada Cloud's API, a second host of the server (default https://ada.glyphh.ai); the fake server's with FAKE_ADA=on
GLYPHH_ADA_URL=http://localhost:8080/ada
# This app's own address; OAuth returns to {PLATFORM_URL}/auth/callback
PLATFORM_URL=http://localhost:3000
# The platform's OAuth client at the server (POST /oauth/register once, token_endpoint_auth_method client_secret_basic)
PLATFORM_CLIENT_ID=
PLATFORM_CLIENT_SECRET=
# 32+ random bytes, base64 (openssl rand -base64 32): seals the session cookie
SESSION_SECRET=
# The client_name the platform registered with; its own consent screens are recognised by it (default Glyphh)
PLATFORM_CLIENT_NAME=Glyphh
# demo.glyphh.ai (server/demo.ts): its Ada Cloud key, never sent to the browser; unset, its API answers 503
DEMO_GLYPHH_API_KEY=
# The host the demo answers on (default demo.glyphh.ai) and its Ada calls a day, all visitors together (default 150)
DEMO_HOST=demo.glyphh.ai
DEMO_DAILY_CALLS=150
