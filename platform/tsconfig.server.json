{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "outDir": "dist/server",
    "rootDir": "."
  },
  "include": ["server"],
  "exclude": ["server/**/*.test.ts", "server/testing.ts", "server/dev.ts"]
}
